# Copy to .env and fill in real values. .env is git-ignored.

# Repository SQL Server connection URL (SQLAlchemy format, used from #3 onward)
DATABASE_URL=
# Redis URL used by the job runner (#11) and sessions (#30)
REDIS_URL=
# Organization OIDC issuer (SSO) and client registration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# LLM provider endpoint and API key used by correlation (#18)
LLM_ENDPOINT=
LLM_API_KEY=
# Optional
LOG_LEVEL=info
# arq worker retry/timeout policy (#11)
JOB_MAX_TRIES=3
JOB_TIMEOUT_SECONDS=300
WORKER_MAX_JOBS=10
WORKER_QUEUE_NAME=arq:queue
JOB_RETRY_JOBS=true