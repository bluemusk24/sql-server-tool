# Front door for the deployed observability backend (#48).
#
# Render exposes a single port, so OTLP and Grafana share it by path:
#   /v1/* (OTLP/HTTP) → collector, gated by the OTLP_INGEST_TOKEN
#         header — the same token dev and prod send in
#         OTEL_EXPORTER_OTLP_HEADERS (dashboard-only secrets).
#         Metrics are stored; traces are accepted and discarded (no
#         Tempo on the 512 MB instance).
#   everything else   → Grafana (login required)
# Prometheus stays on loopback; only Grafana reaches it, from inside
# the container.
{
	admin off
}

:10000 {
	@otlp {
		path /v1/*
		header X-Sdip-Otlp-Token {$OTLP_INGEST_TOKEN}
	}

	handle @otlp {
		reverse_proxy 127.0.0.1:4318
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
