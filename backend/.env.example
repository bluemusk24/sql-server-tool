# The database the backend connects to. SQLAlchemy reads this URL, so the
# value can be swapped for any supported database (SQLite by default;
# Postgres later) without code changes. The product-prefixed
# SDIP_DATABASE_URL takes precedence when both are set — that is the name
# the container run command uses (see README, "One container").
#
#   SQLite (default):   sqlite:///./sqlserver_tool.db
#   SQLite (absolute):  sqlite:////var/data/sqlserver_tool.db
#   Postgres:           postgresql://user:password@localhost:5432/sqldiag
#
# Postgres URLs need no driver suffix — a bare postgresql:// (or the
# legacy postgres:// alias) is pinned to the installed psycopg 3 driver
# automatically. `make postgres` starts a local Postgres container to
# point this at (see README, "Postgres locally").
#
# Copy this file to `.env` (git-ignored) or export the variable in your shell.

DATABASE_URL=sqlite:///./sqlserver_tool.db

# Browser origins allowed by CORS, comma-separated. Unset/blank means the
# local Vite dev servers (http://localhost:5173, http://127.0.0.1:5173), so
# `make run` needs nothing. For a frontend deployed on Vercel, set it to that
# URL, e.g.:
#
#   CORS_ALLOW_ORIGINS=https://my-app.vercel.app
#
# Several origins: comma-separated (no wildcards — the API sends credentials).
CORS_ALLOW_ORIGINS=

# Per-query timeout for live collection against a SQL Server instance (#31),
# in seconds. Used when a run is started with credentials; ignored by the
# demo path.
LIVE_QUERY_TIMEOUT_SECONDS=30

# Overall budget for one diagnostic run (#29), in seconds. A run that
# exceeds it is stopped at the next source boundary, marked failed with
# the reason, and keeps the evidence it already collected (the sources
# it never reached become coverage gaps in the report).
LIVE_RUN_TIMEOUT_SECONDS=600

# ── Seeded demo logins (#41) ────────────────────────────────────────
# The first boot against an empty database seeds two users. The demo
# defaults (dba / dba-password and admin / admin-password) are fine
# locally and on dev; a production copy overrides them via the
# environment so a shared URL never uses the published passwords (#41).
# Re-enforced on every boot: set a value and the seeded login carries
# it; change the value and redeploy to rotate that password (#43).
# Unset keeps the demo defaults.
#SEED_DBA_PASSWORD=
#SEED_ADMIN_PASSWORD=

# ── OIDC single sign-on (#30) ────────────────────────────────────────
# Organization SSO via the authorization-code flow. All three are
# required before GET /auth/authorize stops answering 503; organizations
# themselves are provisioned by an admin via POST /orgs and resolved by
# the verified token issuer (unknown issuers are refused, never
# auto-provisioned).
#
#   OIDC_ISSUER=https://login.example.com/<tenant>/v2.0
#   OIDC_CLIENT_ID=your-client-id
#   OIDC_CLIENT_SECRET=your-client-secret
#
# Registered redirect URI at the issuer: <this app>/auth/callback.
# Defaults to http://localhost:8000/auth/callback; set this explicitly
# behind proxies (Render) so it matches the registered value:
#   OIDC_REDIRECT_URI=https://sql-server-n68y.onrender.com/auth/callback
#
# The production copy uses its own URL (<prod-url>/auth/callback) and
# needs that registered at the issuer as a second redirect URI (#41).

# Where the SPA lives. After a successful login the callback redirects
# to <FRONTEND_URL>/auth/callback?token=<session token> (defaults to the
# Vite dev server).
#FRONTEND_URL=http://localhost:5173

# Directory of built frontend assets the API serves at "/" (#35). The
# single-image Dockerfile sets this to the bundle from its Node stage;
# leave it unset for the dev flow (make run) — the frontend then runs on
# the Vite dev server instead.
# FRONTEND_DIST=/app/frontend
