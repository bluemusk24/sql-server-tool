# The database the backend connects to. SQLAlchemy reads this URL, so the
# value can be swapped for any supported database (SQLite by default;
# Postgres later) without code changes. The product-prefixed
# SDIP_DATABASE_URL takes precedence when both are set — that is the name
# the container run command uses (see README, "One container").
#
#   SQLite (default):   sqlite:///./sqlserver_tool.db
#   SQLite (absolute):  sqlite:////var/data/sqlserver_tool.db
#   Postgres:           postgresql://user:password@localhost:5432/sqldiag
#
# Postgres URLs need no driver suffix — a bare postgresql:// (or the
# legacy postgres:// alias) is pinned to the installed psycopg 3 driver
# automatically. `make postgres` starts a local Postgres container to
# point this at (see README, "Postgres locally").
#
# Copy this file to `.env` (git-ignored) or export the variable in your shell.

DATABASE_URL=sqlite:///./sqlserver_tool.db

# Browser origins allowed by CORS, comma-separated. Unset/blank means the
# local Vite dev servers (http://localhost:5173, http://127.0.0.1:5173), so
# `make run` needs nothing. For a frontend deployed on Vercel, set it to that
# URL, e.g.:
#
#   CORS_ALLOW_ORIGINS=https://my-app.vercel.app
#
# Several origins: comma-separated (no wildcards — the API sends credentials).
CORS_ALLOW_ORIGINS=

# Per-query timeout for live collection against a SQL Server instance (#31),
# in seconds. Used when a run is started with credentials; ignored by the
# demo path.
LIVE_QUERY_TIMEOUT_SECONDS=30

# Directory of built frontend assets the API serves at "/" (#35). The
# single-image Dockerfile sets this to the bundle from its Node stage;
# leave it unset for the dev flow (make run) — the frontend then runs on
# the Vite dev server instead.
# FRONTEND_DIST=/app/frontend
